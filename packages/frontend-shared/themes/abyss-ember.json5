{
	id: 'abyss-ember',

	name: 'Abyss · Ember',
	author: 'iwashi',
	desc: '余烬橙红',
	base: 'dark',
	kind: 'dark',

	props: {
		accent: '#ff7a18',
		accentedBg: ':alpha<0.15<@accent',
		love: '#fb7185',
		focus: ':alpha<0.3<@accent',
		bg: '#0d0705',
		fg: '#f0d8c8',
		fgHighlighted: ':lighten<8<@fg',
		fgOnAccent: '#1a0a05',
		fgOnWhite: '#1a2233',
		divider: 'rgba(255,150,90,0.16)',
		indicator: '@accent',
		panel: '#1a0f0a',
		panelHighlight: '#241410',
		panelHeaderBg: ':alpha<0.65<@panel',
		panelHeaderFg: '@fg',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',
		windowHeader: ':alpha<0.85<@panel',
		popup: '#241410',
		shadow: 'rgba(0,0,0,0.55)',
		header: ':alpha<0.62<@bg',
		navBg: ':alpha<0.66<@panel',
		navFg: ':lighten<18<@fg',
		navActive: '@accent',
		navIndicator: '@indicator',
		pageHeaderBg: ':alpha<0.62<@bg',
		pageHeaderFg: '@fg',
		link: '#ffa94d',
		hashtag: '#ffd166',
		mention: '#ff3d6e',
		mentionMe: '@mention',
		renote: '#34d399',
		modalBg: 'rgba(4,6,12,0.72)',
		scrollbarHandle: ':alpha<0.25<@accent',
		scrollbarHandleHover: ':alpha<0.5<@accent',
		dateLabelFg: ':alpha<0.6<@fg',
		infoBg: ':alpha<0.14<@accent',
		infoFg: ':lighten<35<@accent',
		infoWarnBg: ':alpha<0.16<#f59e0b',
		infoWarnFg: '#fcd34d',
		folderHeaderBg: ':alpha<0.06<@fg',
		folderHeaderHoverBg: ':alpha<0.12<@fg',
		buttonBg: ':alpha<0.10<@fg',
		buttonHoverBg: ':alpha<0.16<@fg',
		buttonGradateA: '@accent',
		buttonGradateB: '#ff3d6e',
		switchBg: ':alpha<0.20<@fg',
		switchOffBg: ':alpha<0.10<@fg',
		switchOffFg: ':alpha<0.8<@panel',
		switchOnBg: '@accent',
		switchOnFg: '#1a0a05',
		inputBorder: ':alpha<0.20<@fg',
		inputBorderHover: ':alpha<0.45<@accent',
		badge: ':alpha<0.16<@accent',
		messageBg: ':alpha<0.12<@accent',
		deckBg: ':darken<3<@bg',
		success: '#34d399',
		error: '#fb7185',
		warn: '#f59e0b',
		codeString: '#6ee7b7',
		codeNumber: '#fbbf24',
		codeBoolean: '#ff3d6e',
		htmlThemeColor: '#0d0705',
	},
}
