		folderHeaderBg: ':alpha<0.06<@fg',
		folderHeaderHoverBg: ':alpha<0.12<@fg',
		buttonBg: ':alpha<0.10<@fg',
		buttonHoverBg: ':alpha<0.16<@fg',
