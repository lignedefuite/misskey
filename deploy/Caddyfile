{
	email {$ACME_EMAIL}
	admin off
}

{$MISSKEY_HOST} {
	encode zstd gzip

	request_body {
		max_size 300MB
	}

	# クライアント起動エラーの収集（アクセスログに記録される）
	@booterror path /__booterror
	respond @booterror 204

	# HTMLはキャッシュさせない（デプロイ直後に古いHTML+新しいアセットの不整合を防ぐ）
	@notAsset not path /vite/* /client-assets/* /twemoji/* /fluent-emojis/* /emoji/* /files/* /proxy/* /static-assets/* /api/* /manifest.json /favicon.ico
	header @notAsset >Cache-Control "no-store"

	reverse_proxy web:3000 {
		transport http {
			read_timeout 360s
			write_timeout 360s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

iwashi.rip, www.iwashi.rip {
	# apex は現在オフライン（静的ページは廃止）
	# 再開する場合はここを file_server などに戻す
	respond 404
}
