{
	email {$ACME_EMAIL}
	admin localhost:2019
}

{$MISSKEY_HOST} {
	encode zstd gzip

	request_body {
		max_size 300MB
	}

	reverse_proxy web:3000 {
		transport http {
			read_timeout 360s
			write_timeout 360s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

# 根域名：首页 = /data/site/index.html（仓库 deploy/apex/），其余路径跳转到 Misskey
# 公开/私密/下线由 deploy/apex.sh 切换（写入 /data/apex-mode.caddy 并热重载）
iwashi.rip, www.iwashi.rip {
	encode zstd gzip

	@root path / /index.html

	handle @root {
		root * /data/site
		import /data/apex-mode.caddy
	}

	handle {
		redir https://{$MISSKEY_HOST}{uri} permanent
	}
}
