{
	email {$ACME_EMAIL}
	admin off
}

{$MISSKEY_HOST} {
	encode zstd gzip

	request_body {
		max_size 300MB
	}

	reverse_proxy web:3000 {
		transport http {
			read_timeout 360s
			write_timeout 360s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}

iwashi.rip, www.iwashi.rip {
	@root path / /index.html

	handle @root {
		root * /data/site
		file_server
		encode zstd gzip
	}

	handle {
		redir https://{$MISSKEY_HOST}{uri} permanent
	}
}
